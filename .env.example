# TAMU Datathon 2026 settings. Copy to .env and fill in only what you use.
# .env is gitignored. Never commit it, paste it in Discord, or put it in a Docker image.
# Check what works with: python toolkit/prize_apis.py

# ---- Competition / RL --------------------------------------------------------
GAME=duel
MODEL=heuristic
FALLBACK=heuristic
BUDGET_MS=150
PORT=8080
TEAM_NAME=
AGENT_NAME=
# Fill in when the challenge gives you these
JUDGE_URL=
SUBMISSION_REPO=

# ---- LLM APIs (MLH: Best Use of Gemini, Best Use of Snowflake API, SpaceXSI raffle) ---
# Key: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Use the Snowflake student trial. Account URL looks like https://<account>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_MODEL=claude-haiku-4-5

# Key: console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Already set in your Windows environment. Only set here to override it.
# OPENAI_API_KEY=

# ---- Databases (MLH: Best Use of Tiger Data, Best Use of MongoDB Atlas) --------
# From the Tiger console. Format: postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
TIGER_DATABASE_URL=

# Atlas > Connect > Drivers. Also add your IP under Network Access.
MONGODB_URI=
MONGODB_DB=datathon

# ---- Cloud (MLH: Best Use of Vultr) --------------------------------------------
# Portal > Account > API. Add your IP under Access Control.
VULTR_API_KEY=

# ---- Solana (MLH: Best Use of Solana) ------------------------------------------
# Devnet only: tokens have no real value. Don't use a wallet that holds real funds.
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- DEV Writing Challenge -----------------------------------------------------
# https://dev.to/settings/extensions
DEVTO_API_KEY=

# ---- Repos (python tools/challenge.py connect) ---------------------------------
# GitHub: fine-grained token with repository Administration and Contents write.
GITHUB_TOKEN=
# Set this to create repos in an organization instead of your account.
GITHUB_ORG=
# GitLab: personal access token with the api scope. Change the URL for a self-hosted GitLab.
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com
GITLAB_NAMESPACE_ID=

# ---- Other challenges ----------------------------------------------------------
DATABRICKS_HOST=
DATABRICKS_TOKEN=
